# ==============================================================================
# Suraksha Grid — Next.js Frontend Environment Variables (.env.example)
# ==============================================================================
# Copy this file to `.env.local` and fill in your real credentials.
# NEVER commit `.env.local` with real secrets to version control.
# ==============================================================================

# Supabase Public Keys (Safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# MapTiler Basemap Public Key
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key

# FastAPI Backend URL (used by Next.js server route handlers)
FASTAPI_BASE_URL=http://localhost:8000
